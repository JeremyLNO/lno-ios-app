    "anomaly.cause.dormant_position.default": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Either the exit condition can no longer trigger, or the process managing it is no longer running."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Soit la condition de sortie ne peut plus se déclencher, soit le processus qui la gère ne tourne plus."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entweder kann die Ausstiegsbedingung nicht mehr auslösen, oder der verwaltende Prozess läuft nicht mehr."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "O la condición de salida ya no puede activarse, o el proceso que la gestiona ya no está en marcha."
          }
        }
      }
    },
    "anomaly.cause.drawdown_rise.default": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Losing trades are clustering instead of being spread out."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les trades perdants se regroupent au lieu de s’étaler."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlusttrades häufen sich, statt sich zu verteilen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las operaciones perdedoras se agrupan en lugar de repartirse."
          }
        }
      }
    },
    "anomaly.cause.exchange_latency.default": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Entries and exits are being placed on stale prices, which shows up later as unexplained slippage."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les entrées et sorties se placent sur des prix périmés, ce qui ressort plus tard en slippage inexpliqué."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein- und Ausstiege werden auf veralteten Kursen platziert, was später als unerklärliche Slippage auftaucht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entradas y salidas se colocan sobre precios obsoletos, lo que aparece después como slippage inexplicado."
          }
        }
      }
    },
    "anomaly.cause.expectation_missed.default": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The strategy is not delivering what it was signed off on. The version history shows whether the edge degraded or the expectation was never realistic."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La stratégie ne délivre pas ce sur quoi elle a été validée. L’historique des versions indique si l’edge s’est dégradé ou si l’attente n’a jamais été réaliste."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Strategie liefert nicht, wofür sie freigegeben wurde. Der Versionsverlauf zeigt, ob die Edge nachgelassen hat oder die Erwartung nie realistisch war."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La estrategia no entrega aquello con lo que fue aprobada. El historial de versiones indica si la ventaja se degradó o la expectativa nunca fue realista."
          }
        }
      }
    },
    "anomaly.cause.long_short_drift.default": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The strategy only works in one direction. In a strongly trending market that is expected rather than broken."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La stratégie ne fonctionne que dans un sens. Dans un marché fortement directionnel c’est attendu, pas cassé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Strategie funktioniert nur in eine Richtung. In einem stark trendenden Markt ist das erwartbar, nicht defekt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La estrategia solo funciona en una dirección. En un mercado fuertemente tendencial eso es esperable, no un fallo."
          }
        }
      }
    },
    "anomaly.cause.loss_concentration.default": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One asset is carrying most of the damage while the others behave."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un seul actif encaisse l’essentiel des dégâts pendant que les autres se comportent normalement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Asset trägt den Großteil des Schadens, während sich die übrigen normal verhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un solo activo carga con la mayor parte del daño mientras el resto se comporta."
          }
        }
      }
    },
    "anomaly.cause.profit_factor_drop.losing": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recent window is losing money overall. Either market conditions moved away from what the entry rules assume, or a parameter change degraded the edge."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La période récente perd de l’argent. Soit les conditions de marché se sont éloignées de ce que supposent les règles d’entrée, soit un changement de paramètre a dégradé l’edge."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der jüngste Zeitraum ist insgesamt defizitär. Entweder haben sich die Marktbedingungen von den Annahmen der Einstiegsregeln entfernt, oder eine Parameteränderung hat die Edge verschlechtert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El periodo reciente pierde dinero en conjunto. O las condiciones de mercado se alejaron de lo que asumen las reglas de entrada, o un cambio de parámetro degradó la ventaja."
          }
        }
      }
    },
    "anomaly.cause.profit_factor_drop.thinning": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The edge is thinning but still positive. Often a regime shift rather than a fault."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’edge s’amincit mais reste positif. Souvent un changement de régime plutôt qu’un défaut."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Edge wird dünner, ist aber noch positiv. Oft ein Regimewechsel statt eines Fehlers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ventaja se adelgaza pero sigue siendo positiva. Suele ser un cambio de régimen más que un fallo."
          }
        }
      }
    },
    "anomaly.cause.slippage_rise.default": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Orders are executing further from their asked price than usual — thinner liquidity, larger size, or a shift from limit to market execution."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les ordres s’exécutent plus loin de leur prix demandé que d’habitude — liquidité plus mince, taille plus grosse, ou passage du limite au marché."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Orders werden weiter von ihrem angeforderten Preis entfernt ausgeführt als üblich — dünnere Liquidität, größere Order, oder ein Wechsel von Limit zu Market."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las órdenes se ejecutan más lejos de su precio pedido de lo habitual — menor liquidez, mayor tamaño, o un paso de límite a mercado."
          }
        }
      }
    },
    "anomaly.cause.trade_frequency.down": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Usually a market regime that no longer meets the entry conditions."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Généralement un régime de marché qui ne remplit plus les conditions d’entrée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meist ein Marktregime, das die Einstiegsbedingungen nicht mehr erfüllt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suele ser un régimen de mercado que ya no cumple las condiciones de entrada."
          }
        }
      }
    },
    "anomaly.cause.trade_frequency.stopped": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The strategy has stopped producing results entirely. Check the exchange connection and the bot’s last activity before assuming a market cause."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La stratégie ne produit plus aucun résultat. Vérifiez la connexion à l’exchange et la dernière activité du bot avant de conclure à une cause de marché."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Strategie liefert überhaupt keine Ergebnisse mehr. Prüfen Sie Börsenverbindung und letzte Bot-Aktivität, bevor Sie eine Marktursache annehmen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La estrategia ha dejado de producir resultados por completo. Compruebe la conexión con el exchange y la última actividad del bot antes de asumir una causa de mercado."
          }
        }
      }
    },
    "anomaly.cause.trade_frequency.up": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Overtrading multiplies fee and funding drag even when the edge holds."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le surtrading multiplie le poids des frais et du funding même quand l’edge tient."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Overtrading vervielfacht Gebühren- und Funding-Last, selbst wenn die Edge hält."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El sobretrading multiplica el peso de comisiones y funding aunque la ventaja se mantenga."
          }
        }
      }
    },
    "anomaly.cause.unfilled_orders.default": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Most of what this strategy places never executes — limit prices too far from the book, or the same intent repriced over and over."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’essentiel de ce que place cette stratégie ne s’exécute jamais — prix limites trop loin du carnet, ou même intention repositionnée sans cesse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das meiste, was diese Strategie platziert, wird nie ausgeführt — Limitpreise zu weit vom Orderbuch, oder dieselbe Absicht immer wieder repreist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La mayor parte de lo que coloca esta estrategia nunca se ejecuta — precios límite demasiado lejos del libro, o la misma intención repuesta una y otra vez."
          }
        }
      }
    },
